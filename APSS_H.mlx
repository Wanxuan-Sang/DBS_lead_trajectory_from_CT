<!DOCTYPE FilterScript>
<FilterScript>
 <filter name="Colorize curvature (APSS)">
  <Param tooltip="Scale of the spatial low pass filter.&#xa;It is relative to the radius (local point spacing) of the vertices." type="RichFloat" name="FilterScale" value="2" description="MLS - Filter scale"/>
  <Param tooltip="Threshold value used to stop the projections.&#xa;This value is scaled by the mean point spacing to get the actual threshold." type="RichFloat" name="ProjectionAccuracy" value="0.0001" description="Projection - Accuracy (adv)"/>
  <Param tooltip="Max number of iterations for the projection." type="RichInt" name="MaxProjectionIters" value="15" description="Projection - Max iterations (adv)"/>
  <Param tooltip="Control the curvature of the fitted spheres: 0 is equivalent to a pure plane fit, 1 to a pure spherical fit, and values between 0 and 1 give intermediate results." type="RichFloat" name="SphericalParameter" value="1" description="MLS - Spherical parameter"/>
  <Param tooltip="If checked, only selected vertices will be projected." type="RichBool" name="SelectionOnly" value="false" description="Selection only"/>
  <Param tooltip="The type of curvature to store." enum_val0="Mean" type="RichEnum" enum_val3="K2" enum_val2="K1" enum_val1="Gauss" name="CurvatureType" value="0" enum_cardinality="5" enum_val4="ApproxMean" description="Curvature type"/>
 </filter>
</FilterScript>
